[Plymouth Theme]
Name=Apex two-step
Description=The Apex fallback splash: the wordmark and the two-step plugin's own bar and field
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/apex-twostep
Font=Adwaita Sans 20
TitleFont=Adwaita Sans 20
MonospaceFont=monospace 20
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.475
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.545
ProgressBarWidth=320
ProgressBarHeight=6
ProgressBarBackgroundColor=0x242424
ProgressBarForegroundColor=0xffffff
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.565
MessageBelowAnimation=true

[boot-up]
UseProgressBar=true
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseProgressBar=false
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseProgressBar=false
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
UseProgressBar=true
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false
