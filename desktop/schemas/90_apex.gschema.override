# Override files apply in lexical order, so 90_ wins over Fedora's 00_ files.
# No color-scheme: the rebuilt gnome-shell draws GNOME's 'default' light.

[org.gnome.desktop.input-sources]
sources=[('xkb', 'us'), ('ibus', 'm17n:vi:telex')]
per-window=true

[org.gnome.desktop.interface]
font-name='Adwaita Sans 10.125'
document-font-name='Adwaita Sans 10.125'
monospace-font-name='JetBrains Mono 9.75'
font-hinting='none'
# Only with the Apex theme in this package: its Inherits= reaches Adwaita's symbolic icons.
icon-theme='Apex'
show-battery-percentage=true
clock-show-weekday=true

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

[org.gnome.desktop.wm.keybindings]
# Super+Space is Spotlight's (io.github.apex_linux.Apex.Desktop.Keybindings).
switch-input-source=['<Super><Alt>space', 'XF86Keyboard']
switch-input-source-backward=['<Shift><Super><Alt>space', '<Shift>XF86Keyboard']

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/apex/apex-facets-light.png'
picture-uri-dark='file:///usr/share/backgrounds/apex/apex-facets-dark.png'

[org.gnome.desktop.notifications]
show-in-lock-screen=false

[org.gnome.desktop.search-providers]
sort-order=['org.gnome.Calculator.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Nautilus.desktop']

[org.gnome.shell]
# The shell hides an entry whose app is not installed, such as Bazaar before the preinstall.
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Epiphany.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Music.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Ptyxis.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Settings.desktop']

[org.gnome.Ptyxis]
# The profile's keys are in dconf's distro database: no override reaches a relocatable schema.
default-profile-uuid='d14b2180d28c41f3a9ee7785f4daa697'
profile-uuids=['d14b2180d28c41f3a9ee7785f4daa697']

[org.gnome.settings-daemon.plugins.power]
# The fingerprint sensor is the power key: 'interactive' does nothing on the lock screen.
power-button-action='interactive'
